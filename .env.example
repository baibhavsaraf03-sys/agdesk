# ---------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel, add these in
# Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Supabase. Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key. SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never
# paste it anywhere the browser can reach. It bypasses every access rule.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic API key for the shared free tier. SERVER ONLY.
# Set a hard spend cap on this key in the Anthropic console before going live.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the shared free tier. Haiku is roughly 2,000 agent exchanges
# per dollar; Sonnet is better at explanation but about 20x the cost.
AGENT_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Providers. Two functions call a model and each picks its own.
#
# The scheduled reads work from material we fetch ourselves (official
# statistics plus GDELT and central bank feeds), so they need no search tool
# and run free on Gemini's free tier. That removes essentially all of the
# running cost of this project.
#
# The analyst answers whatever a visitor types, which here includes students
# pasting their own essays for marking. Free tiers generally reserve the right
# to train on what they receive, so this defaults to Anthropic. Setting
# AGENT_PROVIDER=gemini makes the whole site free - disclose it on TERMS if
# you do.
# ---------------------------------------------------------------------------
FEED_PROVIDER=gemini
AGENT_PROVIDER=anthropic

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Run `node scripts/check-provider.mjs` to see the model ids your key can use.
GEMINI_FEED_MODEL=gemini-flash-latest
GEMINI_AGENT_MODEL=gemini-flash-lite-latest

# Only used when FEED_PROVIDER=anthropic.
FEED_MODEL=claude-sonnet-5-5

# Restores Anthropic's billed web search on the Anthropic feed path. Off by
# default: those searches were the entire running cost.
# FEED_SEARCH=1

# Free-tier agent messages per signed-in account per day.
FREE_DAILY_MESSAGES=20

# Public site URL, used for OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site-wide ceiling on shared-key analyst messages per UTC day. This single
# number decides your worst possible daily bill. On Haiku, 2000 messages is
# roughly $1. Set it from what you are willing to lose.
GLOBAL_DAILY_MESSAGE_CAP=2000

# Comma-separated Supabase user ids exempt from every limit. Put your own id
# here so your account keeps working when the public cap is hit.
ADMIN_USER_IDS=
